<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="1"
    android:layout_gravity="center"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardCornerRadius="40dp"
    app:strokeWidth="0dp">
    <!-- android:alpha="0.85" while scrolling -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/station_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/colorSecondary"
            android:contentDescription="@string/descr_player_station_image"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:shapeAppearanceOverlay="@style/Circle"
            app:srcCompat="@drawable/ic_default_station_image_64dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player_station_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:letterSpacing="0"
            android:singleLine="true"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:layout_constraintBottom_toTopOf="@+id/player_station_metadata"
            app:layout_constraintEnd_toStartOf="@+id/player_play_button"
            app:layout_constraintStart_toEndOf="@+id/station_icon"
            app:layout_constraintTop_toTopOf="@+id/station_icon"
            tools:text="@string/sample_text_station_name" />
        <!-- todo remove android:text attribute here -->

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player_station_metadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:ellipsize="end"
            android:letterSpacing="0"
            android:singleLine="true"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:layout_constraintBottom_toBottomOf="@+id/station_icon"
            app:layout_constraintEnd_toEndOf="@+id/player_station_name"
            app:layout_constraintStart_toStartOf="@+id/player_station_name"
            app:layout_constraintTop_toBottomOf="@+id/player_station_name"
            tools:text="@string/sample_text_station_metadata" />
        <!-- todo remove android:text attribute here -->

        <ImageButton
            android:id="@+id/player_play_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_play_button"
            android:contentDescription="@string/descr_player_playback_button"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="@+id/station_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/station_icon"
            app:srcCompat="@drawable/ic_player_play_symbol_48dp" />

        <ProgressBar
            android:id="@+id/player_buffering_indicator"
            style="?android:attr/progressBarStyle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="2dp"
            android:indeterminateTint="?attr/colorOnPrimary"
            android:indeterminateTintMode="src_in"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/station_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/player_extended_streaming_link_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/descr_expanded_player_streaming_link_icon"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/station_icon"
            app:srcCompat="@drawable/ic_player_extended_music_note_24dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player_extended_streaming_link_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/player_sheet_h2_stream_url"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:layout_constraintBottom_toTopOf="@+id/player_extended_streaming_link"
            app:layout_constraintEnd_toEndOf="@+id/player_extended_streaming_link"
            app:layout_constraintStart_toStartOf="@+id/player_extended_streaming_link" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player_extended_streaming_link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:layout_constraintBottom_toBottomOf="@+id/player_extended_streaming_link_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/player_extended_streaming_link_icon"
            app:layout_constraintTop_toTopOf="@+id/player_extended_streaming_link_icon"
            tools:text="@string/sample_text_steam_url" />

        <ImageButton
            android:id="@+id/player_extended_previous_metadata_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descr_expanded_player_metadata_previous_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/player_extended_streaming_link_icon"
            app:srcCompat="@drawable/ic_player_extended_chevron_left_24dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player_extended_metadata_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/player_sheet_h2_station_metadata"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:layout_constraintBottom_toTopOf="@+id/player_extended_metadata_history"
            app:layout_constraintEnd_toEndOf="@+id/player_extended_metadata_history"
            app:layout_constraintStart_toStartOf="@+id/player_extended_metadata_history" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player_extended_metadata_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:layout_constraintBottom_toBottomOf="@+id/player_extended_previous_metadata_button"
            app:layout_constraintEnd_toStartOf="@+id/player_extended_next_metadata_button"
            app:layout_constraintStart_toEndOf="@+id/player_extended_previous_metadata_button"
            app:layout_constraintTop_toTopOf="@+id/player_extended_previous_metadata_button"
            tools:text="@string/sample_text_station_metadata" />

        <ImageButton
            android:id="@+id/player_extended_next_metadata_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descr_expanded_player_metadata_next_button"
            app:layout_constraintBottom_toBottomOf="@+id/player_extended_previous_metadata_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/player_extended_previous_metadata_button"
            app:srcCompat="@drawable/ic_player_extended_chevron_right_24dp" />

        <ImageButton
            android:id="@+id/timeshift_hour_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descr_expanded_player_timeshift_hour_button"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/player_extended_previous_metadata_button"
            app:srcCompat="@drawable/ic_player_extended_start_of_hour_24dp"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/timeshift_skip_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descr_expanded_player_timeshift_skip_back_button"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/timeshift_hour_button"
            app:layout_constraintStart_toEndOf="@+id/timeshift_hour_button"
            app:layout_constraintTop_toTopOf="@+id/timeshift_hour_button"
            app:srcCompat="@drawable/ic_player_extended_skip_back_30_24dp"
            tools:visibility="visible" />

        <com.google.android.material.slider.Slider
            android:id="@+id/timeshift_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/descr_expanded_player_timeshift_slider"
            android:value="1"
            android:valueFrom="0"
            android:valueTo="1"
            android:visibility="gone"
            app:labelBehavior="floating"
            app:layout_constraintBottom_toBottomOf="@+id/timeshift_skip_back_button"
            app:layout_constraintEnd_toStartOf="@+id/timeshift_skip_forward_button"
            app:layout_constraintStart_toEndOf="@+id/timeshift_skip_back_button"
            app:layout_constraintTop_toTopOf="@+id/timeshift_skip_back_button"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/timeshift_skip_forward_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descr_expanded_player_timeshift_skip_forward_button"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/timeshift_skip_back_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/timeshift_skip_back_button"
            app:srcCompat="@drawable/ic_player_extended_skip_forward_30_24dp"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/timeshift_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/timeshift_go_live_button"
            app:layout_constraintEnd_toStartOf="@+id/timeshift_go_live_button"
            app:layout_constraintStart_toStartOf="@+id/timeshift_slider"
            app:layout_constraintTop_toTopOf="@+id/timeshift_go_live_button"
            tools:text="@string/sample_text_timeshift_position"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timeshift_go_live_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/player_sheet_button_go_live"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:visibility="gone"
            app:icon="@drawable/ic_player_extended_live_24dp"
            app:iconSize="16dp"
            app:iconTint="?attr/colorOnPrimaryContainer"
            app:layout_constraintEnd_toEndOf="@+id/timeshift_slider"
            app:layout_constraintTop_toBottomOf="@+id/timeshift_skip_back_button"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/player_extended_copy_station_metadata_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descr_expanded_player_metadata_copy_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timeshift_go_live_button"
            app:srcCompat="@drawable/ic_player_extended_copy_content_24dp" />

        <ImageButton
            android:id="@+id/sleep_timer_start_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descr_expanded_player_sleep_timer_start_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timeshift_go_live_button"
            app:srcCompat="@drawable/ic_player_extended_sleep_timer_24dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sleep_timer_remaining_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/descr_expanded_player_sleep_timer_remaining_time"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="@+id/sleep_timer_start_button"
            app:layout_constraintEnd_toStartOf="@+id/sleep_timer_start_button"
            app:layout_constraintTop_toTopOf="@+id/sleep_timer_start_button"
            tools:text="@string/sample_text_sleep_timer_remaining_time" />

        <ImageButton
            android:id="@+id/sleep_timer_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descr_expanded_player_sleep_timer_cancel_button"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/sleep_timer_remaining_time"
            app:layout_constraintEnd_toStartOf="@+id/sleep_timer_remaining_time"
            app:layout_constraintTop_toTopOf="@+id/sleep_timer_remaining_time"
            app:srcCompat="@drawable/ic_player_extended_clear_24dp" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/playback_views"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            app:constraint_referenced_ids="station_icon,player_station_name,player_station_metadata,player_play_button"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/player_extended_views"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:constraint_referenced_ids="player_extended_streaming_link_icon,player_extended_streaming_link_headline,player_extended_streaming_link,player_extended_previous_metadata_button,player_extended_metadata_headline,player_extended_metadata_history,player_extended_next_metadata_button,player_extended_copy_station_metadata_button,sleep_timer_start_button"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/timeshift_views"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:constraint_referenced_ids="timeshift_hour_button,timeshift_skip_back_button,timeshift_slider,timeshift_skip_forward_button,timeshift_position"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/sleep_timer_running_views"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:constraint_referenced_ids="sleep_timer_remaining_time,sleep_timer_cancel_button"
            tools:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>